// Cedar schema for the example policies (generated by sentinel.cedar_authz.schema_for).
namespace Sentinel {
  entity Role in [Role];
  entity Person = { "active": Bool, "held": Set<Role>, "covers": Set<Role> };
  entity Agent = { "hasHuman": Bool, "held": Set<Role>, "covers": Set<Role> };
  entity Object;
  type Ctx = { "amount"?: __cedar::decimal, "amountParam": String, "pattern": String, "scope": Set<String>,
               "done": Set<String>, "hasProposers": Bool, "isProposer": Bool };
  action "__approve__" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
  action "approve_po" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
  action "cancel" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
  action "hold" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
  action "notify" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
  action "raise_po" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
  action "refund" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
  action "retry" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
  action "write_off" appliesTo { principal: [Person, Agent], resource: [Object], context: Ctx };
}
