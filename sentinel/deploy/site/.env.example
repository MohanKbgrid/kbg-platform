# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
GRAFANA_ADMIN_PASSWORD=change-me-too

# The overlay package directory on this server (the folder that CONTAINS e.g. acme_sentinel/)
OVERLAY_DIR=/opt/kbgrid/acme-sentinel
SENTINEL_OVERLAY=acme_sentinel:build_overlay
# People, roles and approval authority (inside the overlay, or in ./config)
SENTINEL_DIRECTORY=/overlay/acme_sentinel/people.yaml
# Models: Claude + the small model through the office gateway (see config/models.yaml.example).
# Leave empty to run without a model (LLM steps go to people).
SENTINEL_MODELS=
ANTHROPIC_API_KEY=
SENTINEL_GATEWAY_KEY=

API_PORT=8080
GRAFANA_PORT=3000
WORKER_THREADS=4
WORKER_REPLICAS=1

# Single sign-on for the console (only if config/tokens.yaml has an sso: section)
SENTINEL_OIDC_SECRET=

# Backups (the maintenance service): a directory on this server, ideally copied off-site every night
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_AT=02:30
# Closed cases older than this are archived to BACKUP_DIR/archive and removed from the database
RETENTION_DAYS=365

# Configuration may only read secrets named SENTINEL_SECRET_... (e.g. SENTINEL_SECRET_SHOPIFY_WEBHOOK=...)
# and reach internal addresses listed here (CIDRs or host names), e.g. the WMS or the office Mac mini:
SENTINEL_EGRESS_ALLOW=
# A YAML list of the stdio MCP commands configuration may start (optional), e.g. /config/mcp-commands.yaml
SENTINEL_MCP_COMMANDS=

# Licence (commercial installs; leave unset for open source). Without a valid licence every exception
# goes to a person - nothing stops. The usage key signs the monthly usage export (sentinel usage).
SENTINEL_SITE_ID=
SENTINEL_LICENCE=/config/licence.txt
SENTINEL_LICENCE_KEYS=/config/licence-keys.json
SENTINEL_SECRET_USAGE_KEY=
